# =============================================================================
# Browser (Vite) — required for the React app
# Copy to .env.local and replace placeholders. Never commit .env.local.
# =============================================================================
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Optional: VoiceAgent without login on the main app — must match organizations.public_slug
# VITE_PUBLIC_DEMO_SLUG="your-public-slug"

# =============================================================================
# Platform admin (optional)
# After running migrations, promote yourself in Supabase → SQL Editor:
#   update public.profiles set is_platform_admin = true where email = 'you@example.com';
# Then reload the app: you will see an "Admin" tab with all users and workspaces.
# =============================================================================

# =============================================================================
# Supabase Dashboard → Authentication
# - Enable Google provider (Client ID / Secret from Google Cloud Console)
# - Site URL: e.g. http://localhost:3000
# - Redirect URLs: same origin(s) you use for OAuth return
# =============================================================================

# =============================================================================
# Edge Function secrets (Dashboard → Edge Functions → Secrets), NOT in .env.local
# Hosted projects also receive SUPABASE_URL + SUPABASE_ANON_KEY automatically.
#
# gemini-live-token, gemini-generate:
#   GEMINI_API_KEY=<Google AI Studio / Gemini API key>
#   (Server-only. Never add GEMINI_API_KEY or VITE_GEMINI_* to .env.local — the client uses ephemeral tokens.)
#
# stripe-checkout:
#   STRIPE_SECRET_KEY=sk_...
#   STRIPE_PRICE_ID=price_...
#   SITE_URL=https://your-app.com   (defaults to http://localhost:3000 in code)
#
# stripe-webhook:
#   STRIPE_SECRET_KEY=sk_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   SUPABASE_SERVICE_ROLE_KEY=<service_role key from Project Settings → API>
#
# contact-form (marketing contact page → table public.contact_submissions):
#   SUPABASE_SERVICE_ROLE_KEY=<same service_role key>   # insert rows; auto-provided when hosted
#
# CLI (linked project): supabase secrets set KEY=value
# =============================================================================

# Stripe webhook endpoint (register in Stripe Dashboard → Developers → Webhooks):
#   https://YOUR_PROJECT.supabase.co/functions/v1/stripe-webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
