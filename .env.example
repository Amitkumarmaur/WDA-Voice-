# =============================================================================
# Browser (Vite) — required for the React app
# Copy to .env.local and replace placeholders. Never commit .env.local.
# =============================================================================
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Optional: VoiceAgent without login on the main app — must match organizations.public_slug
# VITE_PUBLIC_DEMO_SLUG="your-public-slug"

# =============================================================================
# Platform admin (optional)
# After running migrations, promote yourself in Supabase → SQL Editor:
#   update public.profiles set is_platform_admin = true where email = 'you@example.com';
# Then reload the app: Admin tab lets you delete users, manage workspaces, view contact form messages,
# grant/revoke admin access, reset voice quotas, and change plans.
# =============================================================================

# =============================================================================
# Supabase Dashboard → Authentication
# - Enable Google provider (Client ID / Secret from Google Cloud Console)
# - Site URL (local): http://localhost:2000
# - Site URL (production): https://wda-voice.vercel.app
# - Redirect URLs — add ALL origins you use:
#     http://localhost:2000/app
#     http://localhost:2000/**
#     https://wda-voice.vercel.app/app
#     https://wda-voice.vercel.app/**
#
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Error 400 redirect_uri_mismatch = add the Supabase callback for YOUR ACTIVE project in Google.
#
# Production (wda-voice.vercel.app) currently uses this Supabase project — add THIS callback:
#     https://xkmxdzzwslkttsptmajd.supabase.co/auth/v1/callback
#
# Local dev (.env.local) uses this project — add THIS callback too if you test locally:
#     https://mkkfmzfhelhcomevuslv.supabase.co/auth/v1/callback
#
# Tip: use ONE Supabase project everywhere (Vercel env + .env.local) to avoid split data.
#
# Authorized JavaScript origins:
#     http://localhost:2000
#     https://wda-voice.vercel.app
#     https://xkmxdzzwslkttsptmajd.supabase.co
#     https://mkkfmzfhelhcomevuslv.supabase.co
#
# Use the legacy anon JWT from Project Settings → API (starts with eyJ…), not service_role.
# =============================================================================

# =============================================================================
# Edge Function secrets (Dashboard → Edge Functions → Secrets), NOT in .env.local
# Hosted projects also receive SUPABASE_URL + SUPABASE_ANON_KEY automatically.
#
# gemini-live-token, gemini-generate:
#   GEMINI_API_KEY=<Google AI Studio / Gemini API key>
#   (Server-only. Never add GEMINI_API_KEY or VITE_GEMINI_* to .env.local — the client uses ephemeral tokens.)
#
# stripe-checkout:
#   STRIPE_SECRET_KEY=sk_...
#   STRIPE_PRICE_ID=price_...
#   SITE_URL=https://your-app.com   (defaults to http://localhost:2000 in stripe-checkout)
#
# stripe-webhook:
#   STRIPE_SECRET_KEY=sk_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   SUPABASE_SERVICE_ROLE_KEY=<service_role key from Project Settings → API>
#
# contact-form (marketing contact page → table public.contact_submissions):
#   SUPABASE_SERVICE_ROLE_KEY=<same service_role key>   # insert rows; auto-provided when hosted
#
# CLI (linked project): supabase secrets set KEY=value
# =============================================================================

# Stripe webhook endpoint (register in Stripe Dashboard → Developers → Webhooks):
#   https://YOUR_PROJECT.supabase.co/functions/v1/stripe-webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
